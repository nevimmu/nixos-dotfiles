<?xml version="1.0" encoding="UTF-8"?>
<!-- Seed monitors.xml for a single internal panel: eDP-1 1920x1080 primary -->
<monitors version="2">
  <configuration>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <monitor>
        <monitorspec>
          <connector>eDP-1</connector>
          <vendor>Unknown</vendor>
          <product>Unknown</product>
          <serial>Unknown</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>60</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>
</monitors>
